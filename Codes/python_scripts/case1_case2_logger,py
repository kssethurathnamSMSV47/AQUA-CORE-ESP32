#!/usr/bin/env python3
"""Separate Case 1 + Case 2 logger, plots, CSVs, and Word report.

Install: python -m pip install pyserial pandas matplotlib python-docx
Run:     python case1_case2_logger.py --port COM5
Commands typed in this terminal are sent to the ESP32: CASE1, CASE2, STOP,
STATUS, REPORT, RESET, HELP, /quit. Close Arduino Serial Monitor first.

The firmware DATA flow and cumulative volume are FT-01-calibrated estimates,
not independent reference measurements. Use --calibration for timed-volume
reference trials. Event volume is integrated from sampled FT-01 flow and is
also an estimate.
"""
from __future__ import annotations
import argparse, csv, datetime as dt, math, queue, re, sys, threading, time
from pathlib import Path
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import serial
from docx import Document
from docx.shared import Inches, Pt

DEFAULT_A, DEFAULT_B = 0.02420192, 0.02599480
DATA_RE = re.compile(r"^DATA,(\d+),([^,]+),(\d+),([-+0-9.eE]+),([-+0-9.eE]+),([-+0-9.eE]+),([01]),([01]),([01])\s*$")
EVENT_RE = re.compile(r"^EVENT,([^,]+),(\d+)\s*$")
COLS = ["esp_millis","mode","pulses","frequency_hz","flow_lpm","total_volume_l","float_triggered","excess_event","solenoid_open","host_timestamp"]

def now():
    return dt.datetime.now().astimezone().isoformat(timespec="milliseconds")

def make_plots(df, out):
    paths=[]
    if df.empty: return paths
    df=df.copy()
    ts=pd.to_datetime(df.host_timestamp, errors="coerce")
    df["elapsed_s"]=(ts-ts.iloc[0]).dt.total_seconds()
    for mode in ("CASE1","CASE2"):
        s=df[df.mode==mode]
        if s.empty: continue
        fig,ax=plt.subplots(figsize=(10,5))
        ax.plot(s.elapsed_s,s.flow_lpm,linewidth=1)
        ax.set(title=f"{mode}: Flow Rate vs Time",xlabel="Elapsed time (s)",ylabel="Flow rate (L/min)")
        ax.grid(True,alpha=.3); fig.tight_layout()
        p=out/f"{mode.lower()}_flow_rate_vs_time.png"; fig.savefig(p,dpi=180); plt.close(fig); paths.append(p)
        fig,ax=plt.subplots(figsize=(10,5))
        ax.plot(s.elapsed_s,s.total_volume_l,linewidth=1)
        ax.set(title=f"{mode}: Cumulative FT-derived Volume vs Time",xlabel="Elapsed time (s)",ylabel="Cumulative volume (L)")
        ax.grid(True,alpha=.3); fig.tight_layout()
        p=out/f"{mode.lower()}_cumulative_volume.png"; fig.savefig(p,dpi=180); plt.close(fig); paths.append(p)
    fig,ax=plt.subplots(figsize=(8,5))
    ax.scatter(df.frequency_hz,df.flow_lpm,s=16,alpha=.7)
    ax.set(title="FT-01 Flow vs Pulse Frequency",xlabel="Pulse frequency (Hz)",ylabel="Firmware-calculated flow (L/min)")
    ax.grid(True,alpha=.3); fig.tight_layout()
    p=out/"ft01_flow_vs_frequency.png"; fig.savefig(p,dpi=180); plt.close(fig); paths.append(p)
    return paths

def build_report(out, df, events, a, b, cal_df, raw_path, plot_paths):
    doc=Document(); sec=doc.sections[0]; sec.top_margin=Inches(.65); sec.bottom_margin=Inches(.65)
    doc.styles["Normal"].font.name="Arial"; doc.styles["Normal"].font.size=Pt(9)
    doc.add_heading("LAM Stage 2 — Case 1 and Case 2 Report",0)
    doc.add_paragraph(f"Generated: {now()}")
    doc.add_paragraph(f"Calibration equation: Q = {a:.8f} f + {b:.7f}; Q in L/min, f in Hz.")
    doc.add_paragraph("Data note: flow and cumulative volume are derived from FT-01 and are not independent reference measurements.")
    doc.add_heading("1. Overall statistics",1)
    if df.empty: doc.add_paragraph("No DATA telemetry rows were captured. Confirm updated firmware, baud 115200, and correct COM port.")
    else:
        doc.add_paragraph(f"Samples: {len(df)}; mean flow {df.flow_lpm.mean():.3f} L/min; minimum {df.flow_lpm.min():.3f}; maximum {df.flow_lpm.max():.3f}.")
        for mode in ("CASE1","CASE2"):
            s=df[df.mode==mode]
            if not s.empty:
                doc.add_heading(mode,2)
                doc.add_paragraph(f"Samples: {len(s)}; mean {s.flow_lpm.mean():.3f} L/min; min {s.flow_lpm.min():.3f}; max {s.flow_lpm.max():.3f} L/min; last FT-derived total {s.total_volume_l.iloc[-1]:.4f} L.")
                doc.add_paragraph(f"Mean frequency {s.frequency_hz.mean():.3f} Hz; mean pulse count per DATA interval {s.pulses.mean():.2f}.")
    doc.add_heading("2. Data fields recorded",1)
    doc.add_paragraph("esp_millis, mode, pulses, frequency_hz, flow_lpm, total_volume_l, float_triggered, excess_event, solenoid_open, host_timestamp.")
    doc.add_heading("3. FT-01 frequency-to-flow relationship",1)
    doc.add_paragraph(f"The firmware reports Q = {a:.8f} × f + {b:.7f}. The flow-vs-frequency plot uses flow already calculated by the firmware, so it visualizes the operating relationship but is not independent calibration validation.")
    doc.add_heading("4. Float event duration and estimated volume",1)
    if events:
        for i,e in enumerate(events,1):
            if e.get("start_s") is not None and e.get("end_s") is not None:
                duration=e["end_s"]-e["start_s"]
                vol=0.0
                s=df.sort_values("esp_millis")
                tm=s.esp_millis.to_numpy(float)/1000; fl=s.flow_lpm.to_numpy(float)
                for j in range(1,len(tm)):
                    overlap=max(0,min(tm[j],e["end_s"])-max(tm[j-1],e["start_s"]))
                    if overlap>0 and math.isfinite(fl[j]): vol+=max(0,fl[j])*overlap/60
                doc.add_paragraph(f"Event {i} ({e['type']} to FLOAT_NORMAL): duration {duration:.3f} s; FT-sample-integrated volume estimate {vol:.4f} L.")
    else: doc.add_paragraph("No complete FLOAT_TRIGGER to FLOAT_NORMAL event was captured.")
    doc.add_paragraph("Event volume is a sampled FT-derived estimate. Compare against independently measured tank/collected volume over the same event boundaries.")
    if cal_df is not None:
        doc.add_heading("5. Independent collected-volume calibration",1)
        x=cal_df.frequency_hz.to_numpy(float); y=cal_df.independent_flow_lpm.to_numpy(float)
        pred=a*x+b; err=pred-y
        ssres=float((err**2).sum()); sstot=float(((y-y.mean())**2).sum())
        r2=1-ssres/sstot if sstot>1e-12 else float("nan")
        doc.add_paragraph(f"Trials: {len(cal_df)}; fixed-equation R²={r2:.5f}; MAE={abs(err).mean():.4f} L/min; maximum absolute error={abs(err).max():.4f} L/min.")
        c=doc.add_table(rows=1,cols=5); c.style="Light Shading Accent 1"
        for cell,label in zip(c.rows[0].cells,["Trial","f (Hz)","Reference Q","Predicted Q","Error"]): cell.text=label
        for i,row in cal_df.iterrows():
            cells=c.add_row().cells
            vals=[str(row.get("trial",i+1)),f"{row.frequency_hz:.4f}",f"{row.independent_flow_lpm:.4f}",f"{(a*row.frequency_hz+b):.4f}",f"{(a*row.frequency_hz+b-row.independent_flow_lpm):+.4f}"]
            for cell,val in zip(cells,vals): cell.text=val
    doc.add_heading("6. Plots generated",1)
    for p in plot_paths:
        doc.add_paragraph(p.name)
        doc.add_picture(str(p),width=Inches(6.2))
    doc.add_heading("7. Limitations",1)
    doc.add_paragraph("The logger cannot independently measure water volume. Calibrate using timed collected-volume trials. The script does not alter firmware coefficients. Verify GPIO wiring, pump-driver enable logic, float-switch polarity, solenoid fail-state, and emergency stop before operation.")
    path=out/"Case1_Case2_Experiment_Report.docx"; doc.save(path); return path

def load_cal(path):
    if not path: return None
    d=pd.read_csv(path)
    need={"pulses","duration_s","collected_volume_l"}
    if not need.issubset(d.columns): raise ValueError(f"Calibration CSV needs columns: {sorted(need)}")
    for c in need: d[c]=pd.to_numeric(d[c],errors="coerce")
    d["frequency_hz"]=pd.to_numeric(d["frequency_hz"],errors="coerce") if "frequency_hz" in d else float("nan")
    m=d.frequency_hz.isna()
    d.loc[m,"frequency_hz"]=d.loc[m,"pulses"]/d.loc[m,"duration_s"]
    d["independent_flow_lpm"]=60*d.collected_volume_l/d.duration_s
    d=d.replace([float("inf"),-float("inf")],float("nan")).dropna(subset=["frequency_hz","duration_s","collected_volume_l","independent_flow_lpm"])
    d=d[(d.duration_s>0)&(d.collected_volume_l>=0)]
    if len(d)<2: raise ValueError("At least two valid calibration rows are required.")
    return d

def main():
    ap=argparse.ArgumentParser(description="Separate Case 1 + Case 2 ESP32 logger and report")
    ap.add_argument("--port",required=True); ap.add_argument("--baud",type=int,default=115200)
    ap.add_argument("--outdir",default="case1_case2_runs"); ap.add_argument("--a",type=float,default=DEFAULT_A); ap.add_argument("--b",type=float,default=DEFAULT_B)
    ap.add_argument("--calibration",default=""); args=ap.parse_args()
    out=Path(args.outdir)/dt.datetime.now().strftime("run_%Y%m%d_%H%M%S"); out.mkdir(parents=True)
    raw_path=out/"serial_log.txt"; sample_path=out/"samples.csv"; event_path=out/"events.csv"
    cal=load_cal(args.calibration) if args.calibration else None
    rows=[]; events=[]; raw=[]; open_event=None
    print(f"Output folder: {out.resolve()}")
    print("Type CASE1, CASE2, STOP, STATUS, REPORT, RESET, HELP. Type /quit to finish. Close Arduino Serial Monitor first.")
    ser=serial.Serial(args.port,args.baud,timeout=.25); time.sleep(2)
    q=queue.Queue(); stop=threading.Event()
    def keyboard():
        while not stop.is_set():
            line=sys.stdin.readline()
            if not line: break
            line=line.strip()
            if line.lower()=="/quit": stop.set(); break
            if line: q.put(line)
    threading.Thread(target=keyboard,daemon=True).start()
    with raw_path.open("w",encoding="utf-8",buffering=1) as rf, sample_path.open("w",newline="",encoding="utf-8") as sf, event_path.open("w",newline="",encoding="utf-8") as ef:
        sw=csv.DictWriter(sf,fieldnames=COLS); sw.writeheader()
        ew=csv.DictWriter(ef,fieldnames=["host_timestamp","event","esp_millis"]); ew.writeheader()
        try:
            while not stop.is_set():
                while not q.empty():
                    cmd=q.get(); ser.write((cmd+"\n").encode()); rf.write(f"[HOST {now()}] {cmd}\n"); print(f"[sent] {cmd}")
                b=ser.readline()
                if not b: continue
                line=b.decode("utf-8",errors="replace").strip(); ts=now()
                print(line); rf.write(f"[{ts}] {line}\n"); raw.append(line)
                m=DATA_RE.match(line)
                if m:
                    row={"esp_millis":int(m.group(1)),"mode":m.group(2),"pulses":int(m.group(3)),"frequency_hz":float(m.group(4)),"flow_lpm":float(m.group(5)),"total_volume_l":float(m.group(6)),"float_triggered":int(m.group(7)),"excess_event":int(m.group(8)),"solenoid_open":int(m.group(9)),"host_timestamp":ts}
                    rows.append(row); sw.writerow(row); sf.flush()
                e=EVENT_RE.match(line)
                if e:
                    name,ms=e.group(1),int(e.group(2)); ew.writerow({"host_timestamp":ts,"event":name,"esp_millis":ms}); ef.flush()
                    if name=="FLOAT_TRIGGER": open_event={"type":name,"start_s":ms/1000,"esp_millis":ms}
                    elif name=="FLOAT_NORMAL" and open_event:
                        open_event["end_s"]=ms/1000; events.append(open_event); open_event=None
                if "SYSTEM STOP COMPLETE" in line: time.sleep(.5); stop.set()
        except KeyboardInterrupt: print("\nCtrl+C: finalizing.")
        finally: stop.set(); ser.close()
    df=pd.DataFrame(rows,columns=COLS)
    if not df.empty: df.to_csv(sample_path,index=False)
    pd.DataFrame(events).to_csv(out/"float_events.csv",index=False)
    plots=make_plots(df,out); report=build_report(out,df,events,args.a,args.b,cal,raw_path,plots)
    print("\nFINALIZED"); print(f"Samples: {sample_path}\nEvents: {event_path}\nReport: {report}\nPlots: {len(plots)}")

if __name__=="__main__": main()
